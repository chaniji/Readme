{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "color": {
      "palette": [
        { "slug": "base", "color": "#f7f3ee", "name": "Base" },
        { "slug": "contrast", "color": "#1a404d", "name": "Contrast" },
        { "slug": "primary", "color": "#163a45", "name": "Primary" },
        { "slug": "secondary", "color": "#8e6c3d", "name": "Secondary" },
        { "slug": "tertiary", "color": "#d1b894", "name": "Tertiary" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "grenze",
          "fontFamily": "\"Grenze\", Georgia, serif",
          "name": "Grenze"
        },
        {
          "slug": "heading",
          "fontFamily": "\"Fraunces\", Georgia, serif",
          "name": "Heading"
        },
        {
          "slug": "display",
          "fontFamily": "\"MonteCarlo\", cursive, serif",
          "name": "Display"
        }
      ]
    },
    "layout": {
      "contentSize": "640px",
      "wideSize": "1120px"
    },
    "shadow": {
      "presets": []
    }
  },
  "styles": {
    "color": {
      "background": "#f7f3ee",
      "text": "#1a404d"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--grenze)"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700"
        }
      },
      "link": {
        "color": {
          "text": "#163a45"
        }
      },
      "button": {
        "color": {
          "background": "#d1b894",
          "text": "#1a404d"
        },
        "border": {
          "radius": "0.25rem"
        }
      }
    }
  }
}
