{
	"nodes":[
		{"id":"node-client","type":"text","text":"### Client\nSends GET request `/product/{id}`","x":0,"y":0,"width":250,"height":100,"color":"1"},
		{"id":"node-controller","type":"text","text":"### ProductController\nReceives request and calls `PService.getProductById(id)`","x":350,"y":0,"width":300,"height":100,"color":"2"},
		{"id":"node-cache-layer","type":"text","text":"### Spring Cache Layer\nCheck `@Cacheable` annotation\nKey: `products::{id}`","x":750,"y":0,"width":300,"height":120,"color":"3"},
		{"id":"node-redis","type":"text","text":"### Redis Database\nStorage for cached products","x":750,"y":-250,"width":300,"height":100,"color":"4"},
		{"id":"node-service","type":"text","text":"### ProductService\n(Cache Miss Path)\n1. `StimulateslowDB()` (3s delay)\n2. Creates new Product object","x":1150,"y":0,"width":350,"height":150,"color":"5"},
		{"id":"node-response","type":"text","text":"### JSON Response\nReturns Product data to Client","x":350,"y":250,"width":300,"height":100,"color":"6"}
	],
	"edges":[
		{"id":"edge-1","fromNode":"node-client","fromSide":"right","toNode":"node-controller","toSide":"left","label":"HTTP GET"},
		{"id":"edge-2","fromNode":"node-controller","fromSide":"right","toNode":"node-cache-layer","toSide":"left"},
		{"id":"edge-3","fromNode":"node-cache-layer","fromSide":"top","toNode":"node-redis","toSide":"bottom","label":"1. Check Cache"},
		{"id":"edge-4","fromNode":"node-redis","fromSide":"bottom","toNode":"node-cache-layer","toSide":"top","label":"2. Return Data (Hit)"},
		{"id":"edge-5","fromNode":"node-cache-layer","fromSide":"right","toNode":"node-service","toSide":"left","label":"3. If Cache Miss"},
		{"id":"edge-6","fromNode":"node-service","fromSide":"left","toNode":"node-cache-layer","toSide":"right","label":"4. Store result in Redis & Return"},
		{"id":"edge-7","fromNode":"node-cache-layer","fromSide":"bottom","toNode":"node-controller","toSide":"right","label":"Return Product"},
		{"id":"edge-8","fromNode":"node-controller","fromSide":"bottom","toNode":"node-response","toSide":"top"},
		{"id":"edge-9","fromNode":"node-response","fromSide":"left","toNode":"node-client","toSide":"bottom"}
	]
}